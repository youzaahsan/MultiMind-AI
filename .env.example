# MultiMind AI Environment Configuration

# Application Configuration
APP_NAME="MultiMind AI"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True
SECRET_KEY=multimind-ai-super-secret-key-change-in-production-min32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default is SQLite for instant zero-dependency local run; supports PostgreSQL: postgresql+psycopg://user:password@localhost:5432/multimind
DATABASE_URL=sqlite:///./data/multimind.db

# LLM Configuration
# Provider options: mock (offline/local simulation), openai, groq, gemini, anthropic
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Embedding & Vector Database
# Provider options: mock (deterministic 384d semantic vectors), openai, sentence-transformers
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_DB_TYPE=memory_chroma
VECTOR_DB_PATH=./data/vector_store

# RAG & Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K=4
SIMILARITY_THRESHOLD=0.35

# Upload & File Limits
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.csv,.xlsx,.xls,.png,.jpg,.jpeg,.webp
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# Logging
LOG_LEVEL=INFO
LOG_FILE=./data/multimind.log
